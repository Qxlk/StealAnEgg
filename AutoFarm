local function gTW(targetPos, options)
    options = options or {}
    local maxSpeed = options.MaxSpeed or St.MaxSpeed
    local minSpeed = options.MinSpeed or St.MinSpeed
    local decelDist = options.DecelDist or St.DecelDistance
    local arrivalRadius = options.ArrivalRadius or 4.5
    local isLanding = options.IsLanding or false
    local avoidTraps = options.AvoidTraps ~= false

    local lastTick = os.clock()
    local arrivalFrames = 0

    while fr and St.AutoFarm do
        local myChar = lp.Character
        local myHum = myChar and myChar:FindFirstChild("Humanoid")
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))

        if not myRoot or not myHum or myHum.Health <= 0 then
            dSR()
            break
        end

        local curPos = myRoot.Position

        local avoidOffset = Vector3.zero
        if avoidTraps and not isInSpawnZone(curPos) then
            local traps = getTraps()
            for _, trapPos in ipairs(traps) do
                local flatTrap = Vector3.new(trapPos.X, 0, trapPos.Z)
                local flatCur = Vector3.new(curPos.X, 0, curPos.Z)
                local distToTrap = (flatCur - flatTrap).Magnitude
                if distToTrap < 38.0 then
                    local pushDir = (flatCur - trapPos)
                    if pushDir.Magnitude == 0 then pushDir = Vector3.new(1, 0, 0) else pushDir = pushDir.Unit end
                    avoidOffset = avoidOffset + (pushDir * (38.0 - distToTrap) * 2.5)
                end
            end
        end

        local adjustedTarget = targetPos + avoidOffset
        local delta = adjustedTarget - curPos
        local dist = delta.Magnitude

        if dist <= arrivalRadius then
            arrivalFrames = arrivalFrames + 1
            if arrivalFrames >= 3 then
                myRoot.AssemblyLinearVelocity = Vector3.zero
                break
            end
        else
            arrivalFrames = 0
        end

        local now = os.clock()
        local dt = math.clamp(now - lastTick, 0.008, 0.05)
        lastTick = now

        if (curPos - aS.LastPos).Magnitude < 1.0 then
            aS.BlockedTime = aS.BlockedTime + dt
            if aS.BlockedTime >= 1.2 then
                myRoot.CFrame = CFrame.new(curPos.X, curPos.Y + 20.0, curPos.Z)
                myRoot.AssemblyLinearVelocity = Vector3.new(0, 90, 0)
                aS.BlockedTime = 0
            end
        else
            aS.BlockedTime = 0
        end
        aS.LastPos = curPos

        local currentSpeed = maxSpeed
        if isLanding or dist <= decelDist then
            local alpha = math.clamp(dist / decelDist, 0.0, 1.0)
            currentSpeed = minSpeed + (maxSpeed - minSpeed) * (alpha ^ 0.85)
        end

        local dir = delta.Unit
        local vy = dir.Y * currentSpeed

        if curPos.Y <= (St.SafeFloorY + 1.5) and vy < 0 then
            vy = 0
        end

        myRoot.AssemblyLinearVelocity = Vector3.new(
            dir.X * currentSpeed,
            vy,
            dir.Z * currentSpeed
        )

        task.wait(0.015)
    end
end

