end

local function isH()
    local char = lp.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local lh   = char:FindFirstChild("LeftHand")
    local rh   = char:FindFirstChild("RightHand")
    if not (root and lh and rh) then return false end
    local ly = (lh.Position - root.Position).Y
    local ry = (rh.Position - root.Position).Y
    return ly > 0 and ry > 0
end

local function isR()
    local char = lp.Character
    if not char then return false end
    for _, v in ipairs(char:GetDescendants()) do
        if v.Name:find("Ragdoll") then return true end
    end
    return false
end

local function dTp(times, delay)
    times = times or 3
    delay = delay or 0.03
    local p = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not p then return end
    for i = 1, times do
        p.CFrame = CFrame.new(SAFE.X, SAFE.Y, SAFE.Z)
        task.wait(delay)
    end
end

