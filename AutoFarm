local function dSE(ep)
    if not fr then return end
    ia = true

    fSR(ep.Position, true, { AvoidTraps = true })
    if not fr then ia = false; return end

    local safePoint = nil
    local calcThread = task.spawn(function()
        safePoint = getBestSafePointOnLine()
    end)

    local maxAttempts = 3
    local picked = false
    for i = 1, maxAttempts do
        if not fr then break end

        pcall(function()
            keypress(0x45)
            local hTime = gH()
            task.wait(hTime)
            keyrelease(0x45)
        end)

        task.wait(0.1)

        if not ex(ep) then
            picked = true
            break
        end
    end

    if not fr then ia = false; return end

    if not picked then
        ia = false
        return
    end

    if safePoint == nil then
        safePoint = getBestSafePointOnLine()
    end

    fSR(safePoint, true, { AvoidTraps = false })

    task.wait(0.8)

    ia = false
end

