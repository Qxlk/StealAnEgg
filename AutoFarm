local function gSp()
    if not ss then return 800 end
    local v
    if type(ss.Get) == "function" then v = ss.Get() end
    if not v and ss.Value then v = ss.Value end
    return tonumber(v) or 800
end

local function gRh()
    if not hs then return 1.5 end
    local v
    if type(hs.Get) == "function" then v = hs.Get() end
    if not v and hs.Value then v = hs.Value end
    return tonumber(v) or 1.5
end

local function gHd()
    if fastPickupEnabled then return 0 end
    return gRh()
end

local function gAf()
    if not aft then return false end
    if type(aft.Get) == "function" then return aft.Get() end
    return aft.Value == true
end

local function sNc()
    if nc then nc:Disconnect() end
    nc = rs.Stepped:Connect(function()
        local ch = lp.Character
        if ch then
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
end

local function eNc()
    if nc then nc:Disconnect(); nc = nil end
end

local function gTr()
    local t = {}
    local d = ws:FindFirstChild("__DEBRIS")
    if not d then return t end
    for _, v in ipairs(d:GetChildren()) do
        if v.Name == "PlayerTrap" and v:IsA("BasePart") then
            table.insert(t, v.Position)
        end
    end
    return t
end

local function gAp(f, to)
    local t = gTr()
    local dir = to - f
    local dm = dir.Magnitude
    if dm < 0.1 then return nil end
    local dn = dir.Unit

    for _, tp in ipairs(t) do
        local tt = tp - f
        local pr = tt:Dot(dn)
        local cl = f + dn * math.clamp(pr, 0, dm)
        local ds = (tp - cl).Magnitude
        if ds <= tr then
            local rt = Vector3.new(dn.Z, 0, -dn.X)
            local oa = cl + rt * (tr + 3)
            local ob = cl - rt * (tr + 3)
            if (oa - tp).Magnitude > (ob - tp).Magnitude then
                return CFrame.new(oa.X, f.Y, oa.Z)
            else
                return CFrame.new(ob.X, f.Y, ob.Z)
            end
        end
    end
    return nil
end

local function mv(tc, it, sr)
    local ch = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    sr = sr or function() return fr end

    sNc()

    while sr() do
        if it and it() then
            eNc()
            return "INTERRUPTED"
        end

        ch  = lp.Character
        hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then break end

        local csp = gSp()
        if csp <= 0 then task.wait(0.02); continue end

        local dst = (hrp.Position - tc.Position).Magnitude
        if dst < 0.5 then hrp.CFrame = tc; break end

        local dt = task.wait()
        if not sr() then break end
        dt  = tonumber(dt) or 0.016
        csp = gSp()

        local stp = csp * dt
        if stp >= dst then
            hrp.CFrame = tc; break
        else
            hrp.CFrame = hrp.CFrame:Lerp(tc, stp / dst)
        end
    end

    eNc()
    task.wait(0.1 + math.random() * 0.15)
    return sr()
end

local function mvs(tc, it, sr)
    local ch  = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local ap = gAp(hrp.Position, tc.Position)
    if ap then
        local ok = mv(ap, it, sr)
        if not ok or ok == "INTERRUPTED" then return ok end
        ch  = lp.Character
        hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            local ap2 = gAp(hrp.Position, tc.Position)
            if ap2 then
                local ok2 = mv(ap2, it, sr)
                if not ok2 or ok2 == "INTERRUPTED" then return ok2 end
            end
        end
    end

    return mv(tc, it, sr)
end

local function gSz()
    gsz = true
    ia  = true

    mv(fb, nil, function() return fr end)

    gsz = false
    ia  = false
end

local function gPe()
    local sl = ws:FindFirstChild("AreaEggSlotsClient")
    if not sl then return nil end
    local ch  = lp.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local cp = nil
    local md = math.huge

    for _, s in ipairs(sl:GetChildren()) do
        local pv = s:FindFirstChild("MonsterParasiteVisual")
        if pv then
            local pl = pv:FindFirstChild("Plane")
            if pl and pl:IsA("BasePart") then
                local dst = (hrp.Position - pl.Position).Magnitude
                if dst < md then
                    md = dst
                    cp = pl
                end
            end
        end
    end
    return cp
end

local function gSe()
    local sp  = Vector3.new(544.71, 70.43, -364.68)
    local fp  = nil
    local mxd = -1

    local sl = ws:FindFirstChild("AreaEggSlotsClient")
    if sl then
        for _, s in ipairs(sl:GetChildren()) do
            if s:FindFirstChild("RareAreaEggHighlight") then
                local pl = s:FindFirstChild("Plane") or s:FindFirstChildWhichIsA("BasePart")
                if pl and pl:IsA("BasePart") then
                    local dst = (pl.Position - sp).Magnitude
                    if dst > mxd then
                        mxd = dst
                        fp  = pl
                    end
                end
            end
        end
    end
    return fp
end

local function gTP()
    if not localPlot then return nil end
    local tmRender = ws:FindFirstChild("__ClientTreadmillRenders")
    if not tmRender then return nil end
    local render = tmRender:FindFirstChild("TreadmillRender_" .. tostring(localPlot.Name))
    if render then return render:FindFirstChild("BoundingBoxPart") end
    return nil
end

local function eTP()
    pcall(function()
        keypress(0x20); task.wait(0.15); keyrelease(0x20)
    end)
end

local function ex(ep)
    return ep and ep.Parent ~= nil
end

local function dSe(ep)
    if not fr then return end
    ia = true

    local ok = mvs(ep.CFrame, nil, function() return fr end)
    if not ok then ia = false; return end

    task.wait(0.2)
    if not fr then ia = false; return end

    local maxAttempts = 3
    for i = 1, maxAttempts do
        if not fr or not ex(ep) then break end

        pcall(function()
            keypress(0x45)
            local hTime = (i == maxAttempts and fastPickupEnabled) and gRh() or gHd()
            task.wait(hTime)
            keyrelease(0x45)
        end)

        task.wait(0.3)
    end

    if not fr then ia = false; return end

    if not ex(ep) then
        gSz()
    else
        ia = false
    end
end

local function dPe(ep)
    if not fr or not pe then return end
    ia = true

    local ms = mvs(ep.CFrame,
        function() return not gsz and (gSe() ~= nil) end,
        function() return fr and pe end
    )

    if ms == "INTERRUPTED" then ia = false; return end
    if not ms then ia = false; return end

    task.wait(0.2)
    if not fr or not pe then ia = false; return end

    local maxAttempts = 3
    for i = 1, maxAttempts do
        if not fr or not pe or not ex(ep) then break end

        pcall(function()
            keypress(0x45)
            local hTime = (i == maxAttempts and fastPickupEnabled) and gRh() or gHd()
            task.wait(hTime)
            keyrelease(0x45)
        end)

        task.wait(0.3)
    end

    if not fr then ia = false; return end

    if not ex(ep) then
        local sl   = ep.Parent and ep.Parent.Parent
        local isSp = sl and sl:FindFirstChild("RareAreaEggHighlight") ~= nil

        if isSp or not gAf() then
            gSz()
        else
            local ok = mv(mfp, nil, function() return fr end)
            if ok and fr then
                task.wait(0.5)
                pcall(function()
                    keypress(0x45)
                    task.wait(2.0)
                    keyrelease(0x45)
                end)
            end
            ia = false
        end
    else
        ia = false
    end
end

local function sFl()
    if ft then return end
    ft = task.spawn(function()
        local lastSeState = false
        local lastPeState = false

        while fr do
            if gsz or ia then task.wait(0.1); continue end

            local act = false

            local se = gSe()
            if se then
                act = true
                if not lastSeState then
                    lastSeState = true
                    task.wait(3.0)
                    se = gSe()
                end
                if se and fr then dSe(se) end
            else
                lastSeState = false
            end

            if not act and pe then
                local pe_egg = gPe()
                if pe_egg then
                    act = true
                    if not lastPeState then
                        lastPeState = true
                        task.wait(3.0)
                        pe_egg = gPe()
                    end
                    if pe_egg and fr then dPe(pe_egg) end
                else
                    lastPeState = false
                end
            end

            if not act then
                if tmf and localPlot then
                    local tmPart = gTP()
                    if tmPart then
                        local ch  = lp.Character
                        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                        if hrp and (hrp.Position - tmPart.Position).Magnitude > 3 then
                            ia = true
                            local res = mvs(tmPart.CFrame, function()
                                return (gSe() ~= nil) or (pe and gPe() ~= nil)
                            end, function() return fr end)
                            ia = false
                            if res == "INTERRUPTED" then continue end
                        end

                        while fr and tmf do
                            if (gSe() ~= nil) or (pe and gPe() ~= nil) then
                                eTP()
                                task.wait(0.2)
                                break
                            end
                            task.wait(0.2)
                        end
                    else
                        task.wait(0.2)
                    end
                else
                    task.wait(0.2)
                end
            end
        end

        eNc()
        ft = nil
    end)
end

local mt

local function cFs(st, ui)
    if fr == st then return end
    fr = st

    if ui and mt then
        pcall(function()
            if type(mt.Set) == "function" then mt:Set(st)
            elseif mt.Value ~= nil then mt.Value = st end
        end)
    end

    if st then
        lib:Notify({ Title = "Auto Farm", Content = "Auto Farm started!", Duration = 2 })
        enR()  
        task.spawn(sCV)
        sFl()
    else
        lib:Notify({ Title = "Auto Farm", Content = "Auto Farm stopped!", Duration = 2 })
        dsR() 
        eNc()
    end
end

