local function isInSpawnZone(pos)
    return pos.X >= 365.0 and pos.X <= 552.0 and pos.Z >= -582.0 and pos.Z <= -146.0
end

local function getTraps()
    local debris = ws:FindFirstChild("__DEBRIS")
    if not debris then return {} end
    local traps = {}
    for _, obj in ipairs(debris:GetDescendants()) do
        if obj.Name == "PlayerTrap" or obj.Name:find("PlayerTrap") then
            local pos = nil
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") then
                pos = obj.PrimaryPart and obj.PrimaryPart.Position or (obj:FindFirstChildWhichIsA("BasePart", true) and obj:FindFirstChildWhichIsA("BasePart", true).Position)
            end
            if pos then
                table.insert(traps, pos)
            end
        end
    end
    return traps
end

local function getBestSafePointOnLine()
    local traps = getTraps()
    local bestPoint = safeLineStart
    local maxMinDist = -1
    
    for i = 0, 20 do
        local alpha = i / 20
        local p = safeLineStart:Lerp(safeLineEnd, alpha)
        
        local minDistToTrap = math.huge
        for _, trapPos in ipairs(traps) do
            local flatTrap = Vector3.new(trapPos.X, 0, trapPos.Z)
            local flatP = Vector3.new(p.X, 0, p.Z)
            local d = (flatP - flatTrap).Magnitude
            if d < minDistToTrap then
                minDistToTrap = d
            end
        end
        
        if minDistToTrap > maxMinDist then
            maxMinDist = minDistToTrap
            bestPoint = p
        end
    end
    return bestPoint
end

