    end)
end

local mt

local function cF(st, ui)
    if fr == st then return end
    fr = st
    St.AutoFarm = st

    if ui and mt then
        pcall(function()
            if type(mt.Set) == "function" then mt:Set(st)
            elseif mt.Value ~= nil then mt.Value = st end
        end)
    end

    if st then
        ft = nil 
        lib:Notify({ Title = "Auto Farm", Content = "Auto Farm started!", Duration = 2 })
        pcall(sCV)  
        task.wait(1.0) 
        eR()
        local tempSkip = sND
        sND = false 
        sF(tempSkip)
    else
        ft = nil 
        lib:Notify({ Title = "Auto Farm", Content = "Auto Farm stopped!", Duration = 2 })
        dSR()
    end
end

mt = tb:AddToggle({
    Id = "main_farm_toggle", Title = "Start Stop Auto Farm", Default = false,
    Callback = function(st) cF(st, false) end
})

tb:AddKeybind({
    Id = "farm_keybind", Title = "Farm Keybind", Default = "F", Mode = "Toggle",
    Callback = function(s) cF(s, true) end
})

local function sCD(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end

    task.spawn(function()
        while char and char.Parent and hum and hum.Parent do
            if hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth) <= 0.25 then
                if fr then
                    sRF = true
                    cF(false, true) 
                end
                if rS then
                    dSR()
                    task.wait(0.05)
                end
                pcall(function()
                    char:BreakJoints()
                end)
                break
            end
            task.wait(0.15)
        end
    end)

    if hum.Died then
        pcall(function()
            hum.Died:Connect(function()
                if fr then
                    sRF = true
                    cF(false, true)
                else
                    dSR()
                end
            end)
        end)
    end
end

if lp.Character then
    sCD(lp.Character)
end

task.spawn(function()
    local lTC = lp.Character
    while true do
        task.wait(0.3)
        local curChar = lp.Character
        if curChar and curChar ~= lTC then
            lTC = curChar            
            sCD(curChar) 
            
            if sRF then
                task.wait(2.0)  
                local hrp = curChar:WaitForChild("HumanoidRootPart", 10)
                local hum = curChar:WaitForChild("Humanoid", 10)
                if hrp and hum then
                    task.wait(0.5)
                    sRF = false
                    sND = true 
                    cF(true, true) 
                    lib:Notify({ Title = "Auto Farm", Content = "Resumed after respawn!", Duration = 2 })
                end
            end
        end
    end
end)

